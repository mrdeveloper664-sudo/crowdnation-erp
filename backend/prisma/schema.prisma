// NEXERP database schema (Phases 1-3: tenancy, auth, accounting engine, vouchers)
// Conventions:
//  * snake_case tables/columns in PostgreSQL via @map/@@map
//  * every tenant table has company_id and is protected by Row Level Security (see migrations/*_rls_and_integrity)
//  * money is Decimal(19,4) - never floating point

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum AccountNature {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountType {
  GENERAL
  CASH
  BANK
  CUSTOMER
  SUPPLIER
  VAT_INPUT
  VAT_OUTPUT
  FIXED_ASSET
  ACCUMULATED_DEPRECIATION
  INVENTORY
  CAPITAL
  RETAINED_EARNINGS
  INCOME
  EXPENSE
}

enum VoucherType {
  PAYMENT
  RECEIPT
  CONTRA
  JOURNAL
  SALES
  PURCHASE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum VoucherStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

enum PeriodStatus {
  OPEN
  LOCKED
}

enum JournalSource {
  VOUCHER
  OPENING_BALANCE
  REVERSAL
  SYSTEM
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum TaxTreatment {
  STANDARD
  ZERO
  EXEMPT
  OUT_OF_SCOPE
}

enum TaxDirection {
  OUTPUT
  INPUT
}

enum PartyKind {
  CUSTOMER
  SUPPLIER
}

enum DocSide {
  SALES
  PURCHASE
}

enum DocType {
  QUOTATION
  REQUEST
  ORDER
  GRN
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum DocStatus {
  DRAFT
  CONFIRMED
  POSTED
  CANCELLED
  CONVERTED
}

enum Frequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SettlementKind {
  RECEIPT
  PAYMENT
}

enum MovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  OPENING
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

// ---------------------------------------------------------------- tenancy

model Company {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String        @unique // company login code, e.g. "ACME"
  name              String
  legalName         String?       @map("legal_name")
  trn               String?       @unique // UAE tax registration number
  baseCurrency      String        @default("AED") @map("base_currency") @db.VarChar(3)
  country           String        @default("AE") @db.VarChar(2)
  address           String?
  phone             String?
  email             String?
  logoUrl           String?       @map("logo_url")
  fiscalYearStartMonth Int        @default(1) @map("fiscal_year_start_month")
  status            CompanyStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings CompanySetting?

  @@map("companies")
}

model CompanySetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @unique @map("company_id") @db.Uuid
  // accounting preferences
  requireVoucherApproval Boolean @default(false) @map("require_voucher_approval")
  allowSelfApproval      Boolean @default(false) @map("allow_self_approval")
  allowBackdatedPosting  Boolean @default(true) @map("allow_backdated_posting")
  amountDecimals         Int     @default(2) @map("amount_decimals")
  emirate                String  @default("DUBAI") // UAE emirate used on VAT returns
  inventoryMethod        String  @default("WAVG") @map("inventory_method") // WAVG | FIFO
  // voucher numbering: { PAYMENT: "PV", RECEIPT: "RV", ... }
  voucherPrefixes Json   @default("{}") @map("voucher_prefixes")
  preferences     Json   @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_settings")
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, code])
  @@map("branches")
}

// ---------------------------------------------------------------- identity / RBAC

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  email           String
  name            String
  passwordHash    String    @map("password_hash")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@unique([companyId, email])
  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

// Global permission catalogue (resource x action). Not tenant-scoped.
model Permission {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource String
  action   String // view|create|edit|delete|approve|post|cancel|export|print

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  companyId    String @map("company_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  companyId String @map("company_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, type])
  @@map("email_tokens")
}

model Invitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  email      String
  name       String?
  roleId     String    @map("role_id") @db.Uuid
  invitedBy  String    @map("invited_by") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------- accounting setup

model FinancialYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  periods AccountingPeriod[]
  openingBalances LedgerOpeningBalance[]

  @@unique([companyId, name])
  @@index([companyId, startDate, endDate])
  @@map("financial_years")
}

model AccountingPeriod {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  financialYearId String       @map("financial_year_id") @db.Uuid
  name            String
  startDate       DateTime     @map("start_date") @db.Date
  endDate         DateTime     @map("end_date") @db.Date
  status          PeriodStatus @default(OPEN)
  lockedAt        DateTime?    @map("locked_at") @db.Timestamptz(6)
  lockedBy        String?      @map("locked_by") @db.Uuid

  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])
  journalEntries JournalEntry[]

  @@unique([companyId, financialYearId, name])
  @@index([companyId, startDate, endDate])
  @@map("accounting_periods")
}

model ExchangeRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  currency  String   @db.VarChar(3) // foreign currency; rate = base units per 1 foreign unit
  rateDate  DateTime @map("rate_date") @db.Date
  rate      Decimal  @db.Decimal(19, 8)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([companyId, currency, rateDate])
  @@map("exchange_rates")
}

model AccountGroup {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  code      String
  name      String
  nature    AccountNature
  isSystem  Boolean       @default(false) @map("is_system")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   AccountGroup?  @relation("GroupTree", fields: [parentId], references: [id])
  children AccountGroup[] @relation("GroupTree")
  accounts Account[]

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@map("account_groups")
}

// "accounts" is the chart-of-accounts leaf; the API exposes them as "ledgers" as well
// (a ledger is a postable account, as in Tally). See docs/accounting-rules.
model Account {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  groupId   String      @map("group_id") @db.Uuid
  code      String
  name      String
  type      AccountType @default(GENERAL)
  systemKey String?     @map("system_key") // stable key for engine-referenced accounts (e.g. VAT_OUTPUT)
  currency  String?     @db.VarChar(3) // null = base currency
  description String?
  isSystem  Boolean     @default(false) @map("is_system")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  group           AccountGroup           @relation(fields: [groupId], references: [id])
  openingBalances LedgerOpeningBalance[]
  journalLines    JournalEntryLine[]
  voucherLines    VoucherLine[]

  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@index([companyId, groupId])
  @@map("accounts")
}

model LedgerOpeningBalance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  financialYearId String   @map("financial_year_id") @db.Uuid
  debit           Decimal  @default(0) @db.Decimal(19, 4)
  credit          Decimal  @default(0) @db.Decimal(19, 4)
  posted          Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account       Account       @relation(fields: [accountId], references: [id])
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id])

  @@unique([accountId, financialYearId])
  @@map("ledger_opening_balances")
}

model DocumentSequence {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String @map("company_id") @db.Uuid
  key             String // e.g. "VOUCHER:PAYMENT", "JOURNAL"
  financialYearId String @map("financial_year_id") @db.Uuid
  lastNumber      Int    @default(0) @map("last_number")

  @@unique([companyId, key, financialYearId])
  @@map("document_sequences")
}

// ---------------------------------------------------------------- journal (immutable once written)

model JournalEntry {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  entryNumber    String        @map("entry_number")
  entryDate      DateTime      @map("entry_date") @db.Date
  periodId       String        @map("period_id") @db.Uuid
  sourceType     JournalSource @map("source_type")
  sourceId       String?       @map("source_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key")
  reversalOfId   String?       @unique @map("reversal_of_id") @db.Uuid
  currency       String        @db.VarChar(3)
  exchangeRate   Decimal       @default(1) @map("exchange_rate") @db.Decimal(19, 8)
  narration      String?
  branchId       String?       @map("branch_id") @db.Uuid
  postedBy       String        @map("posted_by") @db.Uuid
  postedAt       DateTime      @default(now()) @map("posted_at") @db.Timestamptz(6)

  period     AccountingPeriod   @relation(fields: [periodId], references: [id])
  reversalOf JournalEntry?      @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy JournalEntry?      @relation("Reversal")
  lines      JournalEntryLine[]

  @@unique([companyId, entryNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, entryDate])
  @@index([companyId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  entryId       String   @map("entry_id") @db.Uuid
  lineNo        Int      @map("line_no")
  accountId     String   @map("account_id") @db.Uuid
  debit         Decimal  @default(0) @db.Decimal(19, 4) // base currency
  credit        Decimal  @default(0) @db.Decimal(19, 4) // base currency
  foreignAmount Decimal? @map("foreign_amount") @db.Decimal(19, 4) // signed original amount, if foreign
  description   String?
  branchId      String?  @map("branch_id") @db.Uuid

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])

  @@unique([entryId, lineNo])
  @@index([companyId, accountId])
  @@index([entryId])
  @@map("journal_entry_lines")
}

// ---------------------------------------------------------------- vouchers

model Voucher {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  type         VoucherType
  number       String
  voucherDate  DateTime      @map("voucher_date") @db.Date
  reference    String?
  narration    String?
  status       VoucherStatus @default(DRAFT)
  currency     String        @db.VarChar(3)
  exchangeRate Decimal       @default(1) @map("exchange_rate") @db.Decimal(19, 8)
  totalAmount  Decimal       @default(0) @map("total_amount") @db.Decimal(19, 4)
  branchId     String?       @map("branch_id") @db.Uuid
  createdBy    String        @map("created_by") @db.Uuid
  submittedBy  String?       @map("submitted_by") @db.Uuid
  approvedBy   String?       @map("approved_by") @db.Uuid
  approvedAt   DateTime?     @map("approved_at") @db.Timestamptz(6)
  rejectedReason String?     @map("rejected_reason")
  postedBy     String?       @map("posted_by") @db.Uuid
  postedAt     DateTime?     @map("posted_at") @db.Timestamptz(6)
  journalEntryId   String?   @unique @map("journal_entry_id") @db.Uuid
  reversalEntryId  String?   @unique @map("reversal_entry_id") @db.Uuid
  cancelledBy  String?       @map("cancelled_by") @db.Uuid
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?       @map("cancel_reason")
  replacesId   String?       @map("replaces_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines VoucherLine[]

  @@unique([companyId, type, number])
  @@index([companyId, status])
  @@index([companyId, voucherDate])
  @@map("vouchers")
}

model VoucherLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  voucherId   String  @map("voucher_id") @db.Uuid
  lineNo      Int     @map("line_no")
  accountId   String  @map("account_id") @db.Uuid
  debit       Decimal @default(0) @db.Decimal(19, 4) // transaction currency
  credit      Decimal @default(0) @db.Decimal(19, 4) // transaction currency
  description String?
  taxRateId     String?  @map("tax_rate_id") @db.Uuid
  taxableAmount Decimal? @map("taxable_amount") @db.Decimal(19, 4)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([voucherId, lineNo])
  @@index([companyId, accountId])
  @@map("voucher_lines")
}

// ---------------------------------------------------------------- cross-cutting

model Attachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  sha256      String
  storageKey  String   @map("storage_key")
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, entityType, entityId])
  @@map("attachments")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------- Phase 4: VAT

// Versioned by effective date: several rows may share a code (rate changes over time).
model TaxRate {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  code          String
  name          String
  treatment     TaxTreatment
  rate          Decimal      @db.Decimal(7, 4) // percent, e.g. 5.0000
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  isActive      Boolean      @default(true) @map("is_active")
  // UAE reverse charge: the recipient accounts for output and (recoverable) input VAT on a purchase; VAT 201 boxes 3 and 10
  isReverseCharge Boolean    @default(false) @map("is_reverse_charge")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([companyId, code, effectiveFrom])
  @@map("tax_rates")
}

// Signed amounts: credit notes / reversals appear as negative rows.
model TaxTransaction {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  journalEntryId String?      @map("journal_entry_id") @db.Uuid
  sourceType     String       @map("source_type")
  sourceId       String?      @map("source_id") @db.Uuid
  taxRateId      String       @map("tax_rate_id") @db.Uuid
  direction      TaxDirection
  treatment      TaxTreatment
  emirate        String
  txnDate        DateTime     @map("txn_date") @db.Date
  taxableAmount  Decimal      @map("taxable_amount") @db.Decimal(19, 4)
  taxAmount      Decimal      @map("tax_amount") @db.Decimal(19, 4)
  isAdjustment   Boolean      @default(false) @map("is_adjustment")
  isReversal     Boolean      @default(false) @map("is_reversal")
  isReverseCharge Boolean     @default(false) @map("is_reverse_charge")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, txnDate])
  @@index([companyId, sourceType, sourceId])
  @@map("tax_transactions")
}

// ---------------------------------------------------------------- Phase 6: parties, sales & purchases
// Customers and suppliers share one table (a party can be both); views `customers` / `suppliers` expose them.
model Party {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  kind             PartyKind
  code             String
  name             String
  trn              String?
  email            String?
  phone            String?
  address          String?
  contactPerson    String?   @map("contact_person")
  creditLimit      Decimal?  @map("credit_limit") @db.Decimal(19, 4)
  paymentTermsDays Int       @default(30) @map("payment_terms_days")
  accountId        String    @map("account_id") @db.Uuid // ledger in the chart of accounts
  isActive         Boolean   @default(true) @map("is_active")
  notes            String?
