  rejectedReason String?  @map("rejected_reason")
  voucherId     String?   @map("voucher_id") @db.Uuid
  reimburseVoucherId String? @map("reimburse_voucher_id") @db.Uuid
  recurringId   String?   @map("recurring_id") @db.Uuid
  createdBy     String    @map("created_by") @db.Uuid
  approvedBy    String?   @map("approved_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("expenses")
}

model RecurringExpense {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  description String
  net         Decimal   @db.Decimal(19, 4)
  taxCode     String?   @map("tax_code")
  paidFromId  String    @map("paid_from_id") @db.Uuid
  frequency   Frequency
  nextRunDate DateTime  @map("next_run_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  autoPost    Boolean   @default(false) @map("auto_post")
  isActive    Boolean   @default(true) @map("is_active")

  @@map("recurring_expenses")
}

model ExpenseBudget {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  year       Int
  month      Int     @default(0) // 0 = whole year
  amount     Decimal @db.Decimal(19, 4)

  @@unique([companyId, categoryId, year, month])
  @@map("expense_budgets")
}

// ---------------------------------------------------------------- Phase 10: projects & fixed assets
model Project {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  code         String
  name         String
  customerId   String?   @map("customer_id") @db.Uuid
  managerId    String?   @map("manager_id") @db.Uuid // user id
  status       String    @default("PLANNING") // PLANNING ACTIVE ON_HOLD COMPLETED CANCELLED
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  budgetRevenue Decimal  @default(0) @map("budget_revenue") @db.Decimal(19, 4)
  budgetCost   Decimal   @default(0) @map("budget_cost") @db.Decimal(19, 4)
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tasks   ProjectTask[]
  members ProjectMember[]

  @@unique([companyId, code])
  @@map("projects")
}

model ProjectMember {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  role      String @default("MEMBER")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectTask {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  title          String
  description    String?
  assigneeId     String?   @map("assignee_id") @db.Uuid
  status         String    @default("TODO") // TODO IN_PROGRESS REVIEW DONE
  priority       String    @default("MEDIUM")
  dueDate        DateTime? @map("due_date") @db.Date
  estimatedHours Decimal   @default(0) @map("estimated_hours") @db.Decimal(8, 2)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@map("project_tasks")
}

model AssetCategory {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String  @map("company_id") @db.Uuid
  name               String
  usefulLifeMonths   Int     @map("useful_life_months")
  method             String  @default("SL") // SL straight line | DB double declining balance
  assetAccountId     String? @map("asset_account_id") @db.Uuid
  accumDepAccountId  String? @map("accum_dep_account_id") @db.Uuid
  depExpenseAccountId String? @map("dep_expense_account_id") @db.Uuid

  @@unique([companyId, name])
  @@map("asset_categories")
}

model FixedAsset {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  code             String
  name             String
  categoryId       String    @map("category_id") @db.Uuid
  purchaseDate     DateTime  @map("purchase_date") @db.Date
  cost             Decimal   @db.Decimal(19, 4)
  salvageValue     Decimal   @default(0) @map("salvage_value") @db.Decimal(19, 4)
  usefulLifeMonths Int       @map("useful_life_months")
  method           String    @default("SL")
  depreciationStart DateTime @map("depreciation_start") @db.Date
  location         String?
  custodianId      String?   @map("custodian_id") @db.Uuid // employee
  supplierId       String?   @map("supplier_id") @db.Uuid
  status           String    @default("ACTIVE") // ACTIVE DISPOSED
  purchaseVoucherId String?  @map("purchase_voucher_id") @db.Uuid
  disposedAt       DateTime? @map("disposed_at") @db.Date
  disposalProceeds Decimal?  @map("disposal_proceeds") @db.Decimal(19, 4)
  disposalVoucherId String?  @map("disposal_voucher_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  depreciations AssetDepreciation[]

  @@unique([companyId, code])
  @@map("fixed_assets")
}

model AssetDepreciation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  period    String   // YYYY-MM
  amount    Decimal  @db.Decimal(19, 4)
  voucherId String?  @map("voucher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  asset FixedAsset @relation(fields: [assetId], references: [id])

  @@unique([assetId, period])
  @@map("asset_depreciations")
}

model AssetTransfer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  transferDate DateTime @map("transfer_date") @db.Date
  fromLocation String?  @map("from_location")
  toLocation   String?  @map("to_location")
  fromCustodian String? @map("from_custodian") @db.Uuid
  toCustodian  String?  @map("to_custodian") @db.Uuid
  note         String?
  createdBy    String   @map("created_by") @db.Uuid

  @@index([companyId, assetId])
  @@map("asset_transfers")
}

model AssetMaintenance {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  assetId      String    @map("asset_id") @db.Uuid
  serviceDate  DateTime  @map("service_date") @db.Date
  description  String
  cost         Decimal   @default(0) @db.Decimal(19, 4)
  performedBy  String?   @map("performed_by")
  nextDueDate  DateTime? @map("next_due_date") @db.Date
  voucherId    String?   @map("voucher_id") @db.Uuid
  createdBy    String    @map("created_by") @db.Uuid

  @@index([companyId, assetId])
  @@map("asset_maintenance")
}
