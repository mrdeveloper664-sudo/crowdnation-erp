// Sales quotations/orders/invoices/credit notes and purchase requests/orders/GRNs/invoices/debit notes.
// Views `sales_invoices` and `purchase_invoices` expose the invoice subsets.
model Document {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  side           DocSide
  type           DocType
  number         String
  partyId        String    @map("party_id") @db.Uuid
  docDate        DateTime  @map("doc_date") @db.Date
  dueDate        DateTime? @map("due_date") @db.Date
  status         DocStatus @default(DRAFT)
  currency       String    @db.VarChar(3)
  exchangeRate   Decimal   @default(1) @map("exchange_rate") @db.Decimal(19, 8)
  pricesIncludeVat Boolean  @default(false) @map("prices_include_vat")
  net            Decimal   @default(0) @db.Decimal(19, 4)
  vat            Decimal   @default(0) @db.Decimal(19, 4)
  total          Decimal   @default(0) @db.Decimal(19, 4)
  reference      String?
  notes          String?
  sourceDocId    String?   @map("source_doc_id") @db.Uuid
  voucherId      String?   @unique @map("voucher_id") @db.Uuid
  warehouseId    String?   @map("warehouse_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  recurringId    String?   @map("recurring_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  postedAt       DateTime? @map("posted_at") @db.Timestamptz(6)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  party Party          @relation(fields: [partyId], references: [id])
  lines DocumentLine[]

  @@unique([companyId, side, type, number])
  @@index([companyId, side, type, status])
  @@index([companyId, partyId])
  @@map("documents")
}

model DocumentLine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  lineNo       Int      @map("line_no")
  productId    String?  @map("product_id") @db.Uuid
  description  String
  quantity     Decimal  @default(1) @db.Decimal(19, 4)
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(19, 4)
  discountPct  Decimal  @default(0) @map("discount_pct") @db.Decimal(7, 4)
  taxRateId    String?  @map("tax_rate_id") @db.Uuid
  net          Decimal  @default(0) @db.Decimal(19, 4)
  vat          Decimal  @default(0) @db.Decimal(19, 4)
  gross        Decimal  @default(0) @db.Decimal(19, 4)
  accountId    String?  @map("account_id") @db.Uuid
  warehouseId  String?  @map("warehouse_id") @db.Uuid
  batchNo      String?  @map("batch_no")
  serialNos    String[] @default([]) @map("serial_nos")
  sourceLineId String?  @map("source_line_id") @db.Uuid
  receivedQty  Decimal  @default(0) @map("received_qty") @db.Decimal(19, 4)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, lineNo])
  @@map("document_lines")
}

// Customer receipts and supplier payments (views `receipts` / `payments`).
model Settlement {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  kind        SettlementKind
  number      String
  partyId     String         @map("party_id") @db.Uuid
  settleDate  DateTime       @map("settle_date") @db.Date
  accountId   String         @map("account_id") @db.Uuid // cash / bank ledger
  amount      Decimal        @db.Decimal(19, 4)
  method      String         @default("BANK")
  reference   String?
  notes       String?
  voucherId   String?        @unique @map("voucher_id") @db.Uuid
  status      String         @default("POSTED")
  createdBy   String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  // foreign-currency settlement: `amount` is in `currency` (null = company base currency), translated at `exchangeRate`
  currency         String?   @db.VarChar(3)
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(19, 8)
  fxAmount         Decimal   @default(0) @map("fx_amount") @db.Decimal(19, 4) // realised FX in base currency: >0 gain, <0 loss
  fxJournalEntryId String?   @map("fx_journal_entry_id") @db.Uuid

  party Party @relation(fields: [partyId], references: [id])
  allocations SettlementAllocation[]

  @@unique([companyId, kind, number])
  @@map("settlements")
}

// Either a settlement (cash) or a credit/debit note is applied to an invoice.
model SettlementAllocation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  settlementId     String?  @map("settlement_id") @db.Uuid
  creditDocumentId String?  @map("credit_document_id") @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  amount           Decimal  @db.Decimal(19, 4) // in the invoice currency
  baseAmount       Decimal? @map("base_amount") @db.Decimal(19, 4) // carrying value in base currency that this allocation clears
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([creditDocumentId])
  @@map("settlement_allocations")
}

model RecurringInvoice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
