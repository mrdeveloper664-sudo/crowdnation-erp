# Runtime connection: NON-superuser role so Row Level Security is enforced
DATABASE_URL="postgresql://nexerp_app:nexerp_app_pw@localhost:5432/nexerp_dev?schema=public"
# Migrations run as the owner role (creates tables, policies, triggers)
DIRECT_DATABASE_URL="postgresql://nexerp:nexerp_pw@localhost:5432/nexerp_dev?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30
PORT=4000
APP_URL="http://localhost:3000"
AUTH_RATE_LIMIT=10
