# Runtime connection: NON-superuser role so Row Level Security is enforced
DATABASE_URL="postgresql://nexerp_app:nexerp_app_pw@localhost:5432/nexerp_dev?schema=public"
# Migrations run as the owner role (creates tables, policies, triggers)
DIRECT_DATABASE_URL="postgresql://nexerp:nexerp_pw@localhost:5432/nexerp_dev?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30
PORT=4000
APP_URL="http://localhost:3000"
AUTH_RATE_LIMIT=10

# --- optional production integrations ---------------------------------------
# Real email (otherwise messages are only logged):
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="NEXERP <no-reply@example.com>"
# Attachment storage (default: local disk in ./storage):
# STORAGE_DRIVER=s3
# S3_BUCKET=nexerp-files
# S3_REGION=me-central-1
# S3_ENDPOINT=            # set for S3-compatible providers (DigitalOcean Spaces, MinIO)
# Run recurring invoices / expenses / CRM reminders nightly (enable on ONE instance only):
# ENABLE_SCHEDULER=true
